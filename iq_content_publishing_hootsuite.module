<?php

/**
 * @file
 * Hootsuite integration for the Content Publishing framework.
 *
 * OAuth2 authentication is managed centrally by the iq_hootsuite_api module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;

/**
 * Implements hook_entity_operation().
 *
 * Adds the "Fetch Social Profiles" operation to Hootsuite platform
 * config entities on the admin list.
 */
function iq_content_publishing_hootsuite_entity_operation(EntityInterface $entity): array {
  $operations = [];

  if ($entity->getEntityTypeId() !== 'publishing_platform') {
    return $operations;
  }

  /** @var \Drupal\iq_content_publishing\Entity\PublishingPlatformConfigInterface $entity */
  if ($entity->getPluginId() !== 'hootsuite') {
    return $operations;
  }

  // Check if Hootsuite API is connected (token stored in State).
  $accessToken = \Drupal::state()->get('iq_hootsuite_api.access_token');

  if (!empty($accessToken)) {
    $operations['hootsuite_fetch_profiles'] = [
      'title' => t('Fetch Social Profiles'),
      'url' => Url::fromRoute('iq_content_publishing_hootsuite.fetch_profiles', [
        'platform_config' => $entity->id(),
      ]),
      'weight' => 52,
    ];
  }
  else {
    $operations['hootsuite_configure'] = [
      'title' => t('Configure Hootsuite API'),
      'url' => Url::fromRoute('iq_hootsuite_api.settings'),
      'weight' => 50,
    ];
  }

  return $operations;
}
